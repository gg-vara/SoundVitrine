{
  "name": "soundvitrine",
  "version": "0.14.3",
  "description": "SoundVitrine is an hosted iTunes Library portal for the web. Used alongside SoundBuddy, you can broadcast to visitors what you are listening to, and what music you currently have on your computer !",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun server/index.ts",
    "dev": "bun --watch server/index.ts",
    "dev:seed": "vite build && bun server/scripts/seed.ts",
    "dev:client": "vite build --watch",
    "build": "vite build",
    "build:binary": "vite build && bun build --compile --minify --sourcemap server/index.ts --outfile bin/soundvitrine",
    "test:binary": "bun e2e/binary-smoke.ts bin/soundvitrine",
    "test": "bun test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.25",
    "@orpc/openapi": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "@orpc/zod": "^1.16.1",
    "better-auth": "1.7.25",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.65.0",
    "@scalar/api-reference": "^1.76.4",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.4.4",
    "chart.js": "^4.6.1",
    "motion": "^14.9.1",
    "solid-js": "^2.0.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "xstate": "^5.33.3"
  }
}
